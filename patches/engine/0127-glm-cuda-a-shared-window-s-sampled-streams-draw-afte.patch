     moe_fuse: bool = true, // TF_GLM_MOE_FUSE=0: a decode window's EXL3 MoE glue unfused (the same bits either way)
+    draw_batch: bool = true, // TF_GLM_DRAW_BATCH=0: a shared window's sampled streams each draw alone (the same tokens)
