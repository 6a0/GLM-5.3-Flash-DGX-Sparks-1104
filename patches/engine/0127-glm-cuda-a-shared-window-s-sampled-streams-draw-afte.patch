@@ -198,7 +199,7 @@ pub const Engine = struct {
         for (layers, 0..) |*l, i| l.* = @intCast(i);
         const sel = heads(o.drafts, o.drafter, c.mtp); // every rank alike: the same config and options (cuda_ranks)
         if (o.drafts and !sel.drafts and rank == 0) std.log.warn("glm: the checkpoint has no MTP layer (num_nextn_predict_layers 0) and no --drafter is given: decoding without drafts", .{});
-        e.* = .{ .gpa = gpa, .io = io, .heat_gate = .{ .bands = o.settings.heat, .root = @import("cuda_engine_prof.zig").heatRoot() }, .shared_buf = undefined, .d = d, .c = c, .share = share, .spans = spans, .lib = lib, .comm = comm, .checkpoint_digest = checkpoint_digest, .settings = o.settings, .m = m, .stream = stream, .pieces = pieces, .side = side, .moe_fuse = envOn("TF_GLM_MOE_FUSE"), .w = undefined, .capacity = o.capacity, .bp = undefined, .bd = undefined, .pairs = undefined, .smp = undefined, .prompt_out = undefined, .drafts = sel.drafts, .mtp = false };
+        e.* = .{ .gpa = gpa, .io = io, .heat_gate = .{ .bands = o.settings.heat, .root = @import("cuda_engine_prof.zig").heatRoot() }, .shared_buf = undefined, .d = d, .c = c, .share = share, .spans = spans, .lib = lib, .comm = comm, .checkpoint_digest = checkpoint_digest, .settings = o.settings, .m = m, .stream = stream, .pieces = pieces, .side = side, .moe_fuse = envOn("TF_GLM_MOE_FUSE"), .draw_batch = envOn("TF_GLM_DRAW_BATCH"), .w = undefined, .capacity = o.capacity, .bp = undefined, .bd = undefined, .pairs = undefined, .smp = undefined, .prompt_out = undefined, .drafts = sel.drafts, .mtp = false };
         const has_packs = o.settings.dense_bits != 16 or o.settings.head_bits != 16;
         if (has_packs and !o.settings.tiled) return error.PackedNeedsGlmMm;
         const Tile = struct {
@@ -709,6 +710,26 @@ pub const Engine = struct {
             for (parts, segs[0..parts.len]) |p, g| @memcpy(p.out[0..g.rows], outs[g.row0..][0..g.rows]);
             return;
         }
+        // every part sampled, no grammar (the same on every rank): all rows whole in one gather (one group of the
+        // ranks' broadcasts), a draw launch a part under its own rule and positions, then one sync and one read, each
+        // row's token as its part's own draw gives it (TF_GLM_DRAW_BATCH=0: a gather, a draw and a sync a part)
+        var all_sampled = e.draw_batch and !e.structured and rows <= e.smp.rows;
+        for (parts) |p| all_sampled = all_sampled and e.seqs.items[p.slot].?.sampling != null;
+        if (all_sampled) {
+            var draws: [max_shared]sampler.Sampler.Part = undefined;
+            for (parts, segs[0..parts.len], draws[0..parts.len]) |p, g, *d| {
+                try e.bind(p.slot);
+                e.cur.rows_at = b.fnormed + g.row0 * e.c.hidden * 2;
+                d.* = .{ .row0 = g.row0, .rows = g.rows, .first = g.st.pos + 1, .rule = sampler.rule(e.cur.sampling.?), .out = p.out };
+            }
+            try e.smp.gather(e.stream, e.exchange(), e.spans, &.{.{ .rank = e.share.rank, .logits = b.logits }}, rows, e.smp.full.ptr);
+            if (e.discard_draws) { // a follower's rows: their columns to every rank, the draws rank 0's
+                for (parts) |p| @memset(p.out, 0);
+                return;
+            }
+            try e.smp.drawParts(e.stream, draws[0..parts.len]);
+            return e.checkGathers(); // the draws read rows the forward's gathers made
+        }
         for (parts, segs[0..parts.len]) |p, g| {
             try e.bind(p.slot);
             e.cur.rows_at = b.fnormed + g.row0 * e.c.hidden * 2;
diff --git a/zig/src/families/glm/cuda_sampler.zig b/zig/src/families/glm/cuda_sampler.zig
index c8f1e33..bf2aa74 100644
--- a/zig/src/families/glm/cuda_sampler.zig
+++ b/zig/src/families/glm/cuda_sampler.zig
@@ -92,6 +92,38 @@ pub const Sampler = struct {
         try s.tok.download(0, std.mem.sliceAsBytes(out[0..rows]));
     }
 
+    /// One stream's rows of a shared step's whole rows (drawParts): `rows` of them from row `row0` of `full`.
+    pub const Part = struct { row0: usize, rows: usize, first: u64, rule: Rule, out: []u32 };
+
+    /// Several streams' whole rows already in `full` -> each part's `out` under its own rule, as `drawFull` draws each
+    /// part alone (the same kernel on the same rows, keyed by the same positions): a launch a part, its rule and meta
+    /// uploaded ahead of it in stream order, then one sync and one read for them all.
+    pub fn drawParts(s: *Sampler, stream: cuda.Stream, parts: []const Part) !void {
+        const V = s.vocab;
+        var toks: [64]u32 = undefined;
+        var total: usize = 0;
+        for (parts) |p| {
+            if (p.rows == 0 or p.row0 + p.rows > s.rows or p.row0 + p.rows > toks.len or p.out.len < p.rows or p.first < 1) return error.WindowTooWide;
+            const r = p.rule;
+            try s.rule.uploadAsync(0, std.mem.asBytes(&r), stream.handle);
+            const meta = [4]i32{ @intCast(p.first - 1), 0, 0, 0 }; // row r keys meta[0] + r + 1
+            try s.meta.uploadAsync(0, std.mem.asBytes(&meta), stream.handle);
+            var args: cuda.Args = .{};
+            args.add(s.full.ptr + p.row0 * V * 2);
+            args.add(@as(u32, @intCast(V)));
+            args.add(s.rule.ptr);
+            args.add(s.meta.ptr);
+            args.add(@as(i32, 0));
+            args.add(s.tok.ptr + p.row0 * 4);
+            args.add(s.prob.ptr + p.row0 * 4);
+            try cuda.launch.launch(s.tf_draw, .{ .grid = .{ .x = @intCast(p.rows) }, .block = .{ .x = 1024 } }, stream, &args);
+            total = @max(total, p.row0 + p.rows);
+        }
+        try stream.synchronize();
+        try s.tok.download(0, std.mem.sliceAsBytes(toks[0..total]));
+        for (parts) |p| @memcpy(p.out[0..p.rows], toks[p.row0..][0..p.rows]);
+    }
+
     /// `rows` rows of `mine` made whole in `full` (bf16 [rows][vocab]) on every rank, each column from its rank.
     pub fn gather(s: *const Sampler, stream: cuda.Stream, exchange: Exchange, spans: []const Span, mine: []const Local, rows: usize, full: u64) !void {
         const V = s.vocab;
