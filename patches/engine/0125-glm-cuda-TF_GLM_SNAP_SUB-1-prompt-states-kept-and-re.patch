@@ -47,6 +47,36 @@ pub fn rowsAt(start: usize, len: usize, busy: usize) usize {
     return @min(len - start, busy);
 }
 
+/// The rows a kept state may resume on, on every rank: the chunk grid, or with busy steps on a busy step's rows, where
+/// a chunk begun in busy steps is finished in them (`busyAt`, `allowed`). Rank 0 resumes there only under `subOn`.
+pub fn stepGrid(e: *const Engine) usize {
+    return if (e.settings.chunk != 0) e.settings.chunk else fw.prefill_rows;
+}
+
+/// TF_GLM_SNAP_SUB=1, rank 0's word: prompt states are kept and resumed on TF_GLM_CHUNK rows, not only on the chunk
+/// grid, so a later turn prefills at most TF_GLM_CHUNK - 1 rows again instead of 4,095. A row's result does not depend
+/// on which pass holds it (this file's note; glm-solo-check's busy twins), a busy step ends with its rows committed as
+/// a chunk does, and the index rings rebase only at a chunk's start (`ringsAgree`), so the state a pass stands at
+/// after a busy step is the state every pass has there. Busy steps then run where a mark lies inside the chunk and to
+/// finish a chunk begun in them, and no longer beside a decoding stream (`Leader.chunk`). Not with image rows (a busy
+/// step takes none) or TF_GLM_KV_SHARD (its kept states' homes are not checked off the grid).
+pub fn subOn(e: *const Engine) bool {
+    return e.settings.snap_sub and e.settings.chunk != 0 and !e.settings.kv_shard.on and e.images == null;
+}
+
+/// The rows rank 0 keeps and resumes prompt states on: the chunk grid, or under `subOn` a busy step's rows.
+pub fn snapGrid(e: *const Engine) usize {
+    return if (subOn(e)) e.settings.chunk else fw.prefill_rows;
+}
+
+/// Whether one of a pass's marks lies inside (`lo`, `hi`) under `subOn`: a step from `lo` to `hi` would pass the mark
+/// without standing at it, and a state is kept only where a step starts (Engine.prefillChunk).
+pub fn markWithin(e: *const Engine, marks: []const u32, lo: usize, hi: usize) bool {
+    if (!subOn(e)) return false;
+    for (marks) |m| if (m > lo and m < hi) return true;
+    return false;
+}
+
 /// Rank 0's choice for the step at `start` (the others take the ids it sends and the chunk's flag 4): a busy step when
 /// the setting is on, another stream decodes (`solo` false) and nothing reads a chunk's rows. Off the chunk grid the
 /// step is a busy one whatever `solo`: a chunk split into busy steps is finished in them, as no whole chunk starts there.
@@ -133,6 +163,24 @@ test "the MTP head's pass over a step's next ids: the step's rows in one unset,
     try std.testing.expectEqual(@as(usize, 1024), mtpPiece(&e, 3000));
 }
 
+test "TF_GLM_SNAP_SUB: kept states on the busy step's rows, and a mark inside a step's reach is seen" {
+    var e: Engine = undefined;
+    e.settings = .{};
+    e.images = null;
+    try std.testing.expectEqual(@as(usize, fw.prefill_rows), stepGrid(&e));
+    try std.testing.expectEqual(@as(usize, fw.prefill_rows), snapGrid(&e));
+    e.settings.chunk = 1024;
+    try std.testing.expectEqual(@as(usize, 1024), stepGrid(&e)); // every rank resumes there once busy steps are on
+    try std.testing.expectEqual(@as(usize, fw.prefill_rows), snapGrid(&e)); // rank 0 keeps none there unasked
+    try std.testing.expect(!markWithin(&e, &.{5120}, 4096, 8192));
+    e.settings.snap_sub = true;
+    try std.testing.expectEqual(@as(usize, 1024), snapGrid(&e));
+    try std.testing.expect(markWithin(&e, &.{5120}, 4096, 8192));
+    try std.testing.expect(!markWithin(&e, &.{ 4096, 8192 }, 4096, 8192)); // a mark at either end is a step's start
+    e.settings.kv_shard.on = true;
+    try std.testing.expectEqual(@as(usize, fw.prefill_rows), snapGrid(&e));
+}
+
